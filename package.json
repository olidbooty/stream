{
  "name": "stream",
  "version": "0.1.0",
  "private": true,
  "description": "Stream video from torrents in the browser using WebTorrent",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "vite",
    "build": "vite build",
